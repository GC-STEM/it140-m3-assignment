# This workflow is intentionally disabled because Python construction and testing
# are optional practice for the Module Three Assignment. Rename to tests.yml only
# if course maintainers intentionally decide to enable automated practice checks.
name: Optional Python Practice Tests

on:
  push:
  workflow_dispatch:

jobs:
  practice-tests:
    runs-on: ubuntu-24.04
    steps:
      - name: Check out repository
        uses: actions/checkout@v4
      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"
      - name: Run optional acceptance tests
        run: python3 tests/test_paycheck_calculator.py
