        "Amtx",
        "Aofi",
        "Asid",
        "autosize",
        "BISO",
        "Brightspace",
        "ccpid",
        "ccplogid",
        "clipservice",
        "drawio",
        "elif",
        "Fdocument",
        "Ffmt",
        "Fhistory",
        "Fhttp",
        "FIBM",
        "FISO",
        "flowlines",
        "Fsoftware",
        "Fweb",
        "Fwww",
        "Fzotero",
        "grostl",
        "kleine",
